@model WebApp.Models.Admission.CreateAdmissionViewModel
@{
    ViewData["Title"] = "Подать заявление";
}

<h2>Подать заявление</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

<p>Нажмите кнопку ниже, чтобы создать заявление.</p>

<form asp-action="Create" method="post">
    <button type="submit" class="btn btn-success">Подать заявление</button>
</form>
