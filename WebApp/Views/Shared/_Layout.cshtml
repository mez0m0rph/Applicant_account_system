@{
    var accessToken = Context.Session.GetString("AccessToken");
    var userRole = Context.Session.GetString("UserRole");
    var isAuthenticated = !string.IsNullOrWhiteSpace(accessToken);

    var isApplicant = userRole == "Applicant";
    var isManager = userRole == "Manager";
    var isMainManager = userRole == "MainManager";
    var isAdmin = userRole == "Admin";
    var isStaff = isManager || isMainManager || isAdmin;
    var canManageManagers = isMainManager || isAdmin;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ApplicantSystem</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">ApplicantSystem</a>

            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    @if (isAuthenticated && isApplicant)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Applicant" asp-action="Profile">Профиль</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Programs" asp-action="Index">Программы</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Admissions" asp-action="My">Мое заявление</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Documents" asp-action="My">Документы</a>
                        </li>
                    }

                    @if (isAuthenticated && isStaff)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Staff" asp-action="Admissions">Все поступления</a>
                        </li>
                    }

                    @if (isAuthenticated && canManageManagers)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Staff" asp-action="Managers">Менеджеры</a>
                        </li>
                    }
                </ul>

                <ul class="navbar-nav">
                    @if (isAuthenticated)
                    {
                        <li class="nav-item">
                            <span class="nav-link text-muted">@userRole</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Account" asp-action="ChangePassword">Сменить пароль</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Account" asp-action="Logout">Выход</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Вход</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Регистрация</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>

<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2026 - ApplicantSystem
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
