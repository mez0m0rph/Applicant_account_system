@model WebApp.Models.Applicant.ProfileViewModel
@{
    ViewData["Title"] = "Профиль";
}

<h2>Профиль абитуриента</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

@if (Model.HasProfile)
{
    <div class="alert alert-success">Профиль найден. Можно редактировать данные.</div>
}
else
{
    <div class="alert alert-warning">Профиль еще не создан. Заполните форму и нажмите «Сохранить».</div>
}

<form asp-action="Save" method="post">
    <input type="hidden" asp-for="HasProfile" />
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="UserId" />

    <div class="mb-3">
        <label class="form-label">ФИО</label>
        <input asp-for="FullName" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Email</label>
        <input asp-for="Email" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Телефон</label>
        <input asp-for="Phone" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Дата рождения</label>
        <input asp-for="BirthDate" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Пол</label>
        <select asp-for="Gender" class="form-control">
            <option value="0">Male</option>
            <option value="1">Female</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Гражданство</label>
        <input asp-for="Citizenship" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">
        @(Model.HasProfile ? "Сохранить изменения" : "Создать профиль")
    </button>
</form>
