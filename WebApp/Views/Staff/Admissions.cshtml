@model WebApp.Models.Staff.StaffAdmissionsPageViewModel
@{
    ViewData["Title"] = "Все поступления";
    var admissions = Model.PagedAdmissions.Items;
}

<h2>Все поступления</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

<form method="get" class="row g-3 mb-4">
    <div class="col-md-3">
        <label class="form-label">Поиск по email или ФИО</label>
        <input type="text" name="Search" value="@Model.Filter.Search" class="form-control" />
    </div>

    <div class="col-md-2">
        <label class="form-label">Факультет</label>
        <input type="text" name="Faculty" value="@Model.Filter.Faculty" class="form-control" />
    </div>

    <div class="col-md-2">
        <label class="form-label">Статус</label>
        <select name="Status" class="form-control">
            <option value="">Все</option>
            <option value="Created" selected="@(Model.Filter.Status == "Created")">Created</option>
            <option value="OnReview" selected="@(Model.Filter.Status == "OnReview")">OnReview</option>
            <option value="Confirmed" selected="@(Model.Filter.Status == "Confirmed")">Confirmed</option>
            <option value="Rejected" selected="@(Model.Filter.Status == "Rejected")">Rejected</option>
            <option value="Closed" selected="@(Model.Filter.Status == "Closed")">Closed</option>
        </select>
    </div>

    <div class="col-md-2">
        <label class="form-label">Сортировка</label>
        <select name="SortDirection" class="form-control">
            <option value="desc" selected="@(Model.Filter.SortDirection == "desc")">Сначала новые</option>
            <option value="asc" selected="@(Model.Filter.SortDirection == "asc")">Сначала старые</option>
        </select>
    </div>

    <div class="col-md-2">
        <label class="form-label">Размер страницы</label>
        <select name="PageSize" class="form-control">
            <option value="5" selected="@(Model.Filter.PageSize == 5)">5</option>
            <option value="10" selected="@(Model.Filter.PageSize == 10)">10</option>
            <option value="20" selected="@(Model.Filter.PageSize == 20)">20</option>
            <option value="50" selected="@(Model.Filter.PageSize == 50)">50</option>
        </select>
    </div>

    <div class="col-md-1 d-flex align-items-end">
        <div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" name="OnlyUnassigned" value="true" @(Model.Filter.OnlyUnassigned ? "checked" : "") />
                <label class="form-check-label">Свободные</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="OnlyMine" value="true" @(Model.Filter.OnlyMine ? "checked" : "") />
                <label class="form-check-label">Только мои</label>
            </div>
        </div>
    </div>

    <input type="hidden" name="SortBy" value="updatedAt" />
    <input type="hidden" name="Page" value="1" />

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Применить</button>
        <a asp-action="Admissions" class="btn btn-secondary">Сбросить</a>
    </div>
</form>

@if (!admissions.Any())
{
    <div class="alert alert-warning">Поступления пока отсутствуют.</div>
}
else
{
    <div class="mb-3 text-muted">
        Найдено заявлений: @Model.PagedAdmissions.TotalCount
    </div>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ФИО</th>
                <th>Email</th>
                <th>Status</th>
                <th>Programs</th>
                <th>Менеджер</th>
                <th>CreatedAt</th>
                <th>UpdatedAt</th>
                <th>Назначить менеджера</th>
                <th>Снять менеджера</th>
                <th>Изменить статус</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var a in admissions)
        {
            <tr>
                <td>@a.ApplicantFullName</td>
                <td>@a.ApplicantEmail</td>
                <td>@a.Status</td>
                <td>
                    @if (a.Programs == null || !a.Programs.Any())
                    {
                        <span>Нет программ</span>
                    }
                    else
                    {
                        <ul class="mb-0">
                        @foreach (var p in a.Programs.OrderBy(x => x.Priority))
                        {
                            <li>
                                @(string.IsNullOrWhiteSpace(p.ProgramCode) ? "" : $"{p.ProgramCode} — ")
                                @(string.IsNullOrWhiteSpace(p.ProgramTitle) ? p.ProgramId.ToString() : p.ProgramTitle)
                                (приоритет @p.Priority)
                            </li>
                        }
                        </ul>
                    }
                </td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(a.AssignedManagerName))
                    {
                        <span>@a.AssignedManagerName (@a.AssignedManagerEmail)</span>
                    }
                    else
                    {
                        <span>не назначен</span>
                    }
                </td>
                <td>@a.CreatedAt.ToLocalTime()</td>
                <td>@a.UpdatedAt.ToLocalTime()</td>
                <td>
                    @if (Model.Managers.Any())
                    {
                        <form asp-action="AssignManager" method="post">
                            <input type="hidden" name="AdmissionId" value="@a.Id" />
                            <select name="ManagerUserId" class="form-control mb-2">
                                @foreach (var m in Model.Managers)
                                {
                                    <option value="@m.UserId">@m.FullName (@m.Email)</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-primary btn-sm">Назначить</button>
                        </form>
                    }
                    else
                    {
                        <span>Нет менеджеров</span>
                    }
                </td>
                <td>
                    <form asp-action="ReleaseManager" method="post">
                        <input type="hidden" name="admissionId" value="@a.Id" />
                        <button type="submit" class="btn btn-warning btn-sm">Снять</button>
                    </form>
                </td>
                <td>
                    <form asp-action="UpdateAdmissionStatus" method="post">
                        <input type="hidden" name="AdmissionId" value="@a.Id" />
                        <select name="Status" class="form-control mb-2">
                            <option value="Created">Created</option>
                            <option value="OnReview">OnReview</option>
                            <option value="Confirmed">Confirmed</option>
                            <option value="Rejected">Rejected</option>
                            <option value="Closed">Closed</option>
                        </select>
                        <button type="submit" class="btn btn-success btn-sm">Обновить</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>

    @if (Model.PagedAdmissions.TotalPages > 1)
    {
        <nav>
            <ul class="pagination flex-wrap">
                @for (int i = 1; i <= Model.PagedAdmissions.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PagedAdmissions.Page ? "active" : "")">
                        <a class="page-link"
                           asp-action="Admissions"
                           asp-route-Search="@Model.Filter.Search"
                           asp-route-Faculty="@Model.Filter.Faculty"
                           asp-route-Status="@Model.Filter.Status"
                           asp-route-OnlyUnassigned="@Model.Filter.OnlyUnassigned"
                           asp-route-OnlyMine="@Model.Filter.OnlyMine"
                           asp-route-SortBy="@Model.Filter.SortBy"
                           asp-route-SortDirection="@Model.Filter.SortDirection"
                           asp-route-Page="@i"
                           asp-route-PageSize="@Model.Filter.PageSize">
                            @i
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
}
