@model WebApp.Models.Staff.StaffAdmissionsPageViewModel
@{
    ViewData["Title"] = "Все поступления";
}

<h2>Все поступления</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

@if (!Model.Admissions.Any())
{
    <div class="alert alert-warning">Поступления пока отсутствуют.</div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ApplicantEmail</th>
                <th>Status</th>
                <th>Programs</th>
                <th>Менеджер</th>
                <th>CreatedAt</th>
                <th>UpdatedAt</th>
                <th>Назначить менеджера</th>
                <th>Снять менеджера</th>
                <th>Изменить статус</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var a in Model.Admissions)
        {
            <tr>
                <td>@a.ApplicantEmail</td>
                <td>@a.Status</td>
                <td>
                    @if (a.Programs == null || !a.Programs.Any())
                    {
                        <span>Нет программ</span>
                    }
                    else
                    {
                        <ul class="mb-0">
                        @foreach (var p in a.Programs.OrderBy(x => x.Priority))
                        {
                            <li>
                                @(string.IsNullOrWhiteSpace(p.ProgramCode) ? "" : $"{p.ProgramCode} — ")
                                @(string.IsNullOrWhiteSpace(p.ProgramTitle) ? p.ProgramId.ToString() : p.ProgramTitle)
                                (приоритет @p.Priority)
                            </li>
                        }
                        </ul>
                    }
                </td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(a.AssignedManagerName))
                    {
                        <span>@a.AssignedManagerName (@a.AssignedManagerEmail)</span>
                    }
                    else
                    {
                        <span>не назначен</span>
                    }
                </td>
                <td>@a.CreatedAt.ToLocalTime()</td>
                <td>@a.UpdatedAt.ToLocalTime()</td>
                <td>
                    @if (Model.Managers.Any())
                    {
                        <form asp-action="AssignManager" method="post">
                            <input type="hidden" name="AdmissionId" value="@a.Id" />
                            <select name="ManagerUserId" class="form-control mb-2">
                                @foreach (var m in Model.Managers)
                                {
                                    <option value="@m.UserId">@m.FullName (@m.Email)</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-primary btn-sm">Назначить</button>
                        </form>
                    }
                    else
                    {
                        <span>Нет менеджеров</span>
                    }
                </td>
                <td>
                    <form asp-action="ReleaseManager" method="post">
                        <input type="hidden" name="admissionId" value="@a.Id" />
                        <button type="submit" class="btn btn-warning btn-sm">Снять</button>
                    </form>
                </td>
                <td>
                    <form asp-action="UpdateAdmissionStatus" method="post">
                        <input type="hidden" name="AdmissionId" value="@a.Id" />
                        <select name="Status" class="form-control mb-2">
                            <option value="Created">Created</option>
                            <option value="OnReview">OnReview</option>
                            <option value="Confirmed">Confirmed</option>
                            <option value="Rejected">Rejected</option>
                            <option value="Closed">Closed</option>
                        </select>
                        <button type="submit" class="btn btn-success btn-sm">Обновить</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
