@model WebApp.Models.Manager.CreateManagerViewModel
@{
    ViewData["Title"] = "Создать менеджера";
}

<h2>Создать менеджера</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

<form asp-action="CreateManager" method="post">
    <div class="mb-3">
        <label asp-for="FullName" class="form-label">ФИО</label>
        <input asp-for="FullName" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label">Пароль</label>
        <input asp-for="Password" type="password" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Role" class="form-label">Роль</label>
        <select asp-for="Role" class="form-control">
            <option value="Manager">Manager</option>
            <option value="MainManager">MainManager</option>
            <option value="Admin">Admin</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Faculty" class="form-label">Факультет</label>
        <input asp-for="Faculty" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Создать</button>
    <a asp-action="Managers" class="btn btn-secondary">Назад</a>
</form>
