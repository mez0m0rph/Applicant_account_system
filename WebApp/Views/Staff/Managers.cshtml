@model List<WebApp.Models.Manager.ManagerViewModel>
@{
    ViewData["Title"] = "Менеджеры";
}
<h2>Список менеджеров</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

<table class="table">
    <thead>
        <tr>
            <th>ФИО</th>
            <th>Email</th>
            <th>Роль</th>
            <th>Факультет</th>
            <th>Создан</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var manager in Model)
    {
        <tr>
            <td>@manager.FullName</td>
            <td>@manager.Email</td>
            <td>@manager.Role</td>
            <td>@manager.Faculty</td>
            <td>@manager.CreatedAt</td>
        </tr>
    }
    </tbody>
</table>
