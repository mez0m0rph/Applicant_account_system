@model List<WebApp.Models.Manager.ManagerViewModel>
@{
    ViewData["Title"] = "Менеджеры";
    var isAdmin = (ViewBag.IsAdmin as bool?) ?? false;
}

<h2>Менеджеры</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

@if (isAdmin)
{
    <p>
        <a asp-action="CreateManager" class="btn btn-success">Создать менеджера</a>
    </p>
}

@if (!Model.Any())
{
    <div class="alert alert-warning">Менеджеры пока не созданы.</div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ФИО</th>
                <th>Email</th>
                <th>Роль</th>
                <th>Факультет</th>
                <th>Создан</th>
                @if (isAdmin)
                {
                    <th>Действия</th>
                }
            </tr>
        </thead>
        <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td>@m.FullName</td>
                <td>@m.Email</td>
                <td>@m.Role</td>
                <td>@m.Faculty</td>
                <td>@m.CreatedAt.ToLocalTime()</td>
                @if (isAdmin)
                {
                    <td>
                        <a asp-action="EditManager" asp-route-id="@m.Id" class="btn btn-primary btn-sm">Редактировать</a>
                        <form asp-action="DeleteManager" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@m.Id" />
                            <button type="submit" class="btn btn-danger btn-sm">Удалить</button>
                        </form>
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>
}
