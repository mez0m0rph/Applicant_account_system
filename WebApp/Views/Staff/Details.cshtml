@model WebApp.Models.Staff.StaffApplicantDetailsViewModel
@{
    ViewData["Title"] = "Карточка абитуриента";
    var canEdit = (ViewBag.CanEdit as bool?) ?? false;
    var selectedProgramIds = Model.Admission?.Programs.Select(x => x.ProgramId).ToHashSet() ?? new HashSet<Guid>();
    var availablePrograms = Model.AvailablePrograms
        .Where(x => !selectedProgramIds.Contains(x.Id))
        .OrderBy(x => x.Title)
        .ToList();

    var genderText = Model.Profile == null
        ? "-"
        : Model.Profile.Gender == 0
            ? "Мужчина"
            : Model.Profile.Gender == 1
                ? "Женщина"
                : "Не указано";
}

<h2>Карточка абитуриента</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

@if (Model.Profile == null)
{
    <div class="alert alert-warning">Профиль абитуриента не найден.</div>
}
else
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Профиль</span>
            @if (canEdit)
            {
                <a asp-action="EditApplicant" asp-route-applicantUserId="@Model.ApplicantUserId" class="btn btn-sm btn-primary">
                    Редактировать профиль
                </a>
            }
        </div>
        <div class="card-body">
            <p><strong>ФИО:</strong> @Model.Profile.FullName</p>
            <p><strong>Email:</strong> @Model.Profile.Email</p>
            <p><strong>Телефон:</strong> @Model.Profile.Phone</p>
            <p><strong>Дата рождения:</strong> @Model.Profile.BirthDate.ToLocalTime()</p>
            <p><strong>Пол:</strong> @genderText</p>
            <p><strong>Гражданство:</strong> @Model.Profile.Citizenship</p>
        </div>
    </div>
}

<div class="card mb-4">
    <div class="card-header">Заявление</div>
    <div class="card-body">
        @if (Model.Admission == null)
        {
            <p class="mb-0">Заявление отсутствует.</p>
        }
        else
        {
            <p><strong>Status:</strong> @Model.Admission.Status</p>
            <p><strong>Создано:</strong> @Model.Admission.CreatedAt.ToLocalTime()</p>
            <p><strong>Обновлено:</strong> @Model.Admission.UpdatedAt.ToLocalTime()</p>

            <h5 class="mt-3">Программы</h5>
            @if (!Model.Admission.Programs.Any())
            {
                <p class="mb-0">Программы не выбраны.</p>
            }
            else
            {
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Программа</th>
                            <th>Приоритет</th>
                            @if (canEdit)
                            {
                                <th>Действия</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var p in Model.Admission.Programs.OrderBy(x => x.Priority))
                    {
                        <tr>
                            <td>
                                @(string.IsNullOrWhiteSpace(p.ProgramCode) ? "" : $"{p.ProgramCode} — ")
                                @(string.IsNullOrWhiteSpace(p.ProgramTitle) ? p.ProgramId.ToString() : p.ProgramTitle)
                            </td>
                            <td>
                                @if (canEdit)
                                {
                                    <form asp-action="UpdateProgramPriority" method="post" class="d-flex gap-2">
                                        <input type="hidden" name="applicantUserId" value="@Model.ApplicantUserId" />
                                        <input type="hidden" name="admissionId" value="@Model.Admission.Id" />
                                        <input type="hidden" name="programId" value="@p.ProgramId" />
                                        <input type="number" name="priority" value="@p.Priority" min="1" class="form-control" style="max-width:120px;" />
                                        <button type="submit" class="btn btn-sm btn-primary">Сохранить</button>
                                    </form>
                                }
                                else
                                {
                                    <span>@p.Priority</span>
                                }
                            </td>
                            @if (canEdit)
                            {
                                <td>
                                    <form asp-action="RemoveProgramFromAdmission" method="post">
                                        <input type="hidden" name="applicantUserId" value="@Model.ApplicantUserId" />
                                        <input type="hidden" name="admissionId" value="@Model.Admission.Id" />
                                        <input type="hidden" name="programId" value="@p.ProgramId" />
                                        <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            }

            @if (canEdit)
            {
                <h5 class="mt-4">Добавить программу</h5>
                <form asp-action="AddProgramToAdmission" method="post" class="row g-2">
                    <input type="hidden" name="applicantUserId" value="@Model.ApplicantUserId" />
                    <input type="hidden" name="admissionId" value="@Model.Admission.Id" />

                    <div class="col-md-8">
                        <select name="programId" class="form-control">
                            <option value="">Выберите программу</option>
                            @foreach (var program in availablePrograms)
                            {
                                <option value="@program.Id">@program.Code - @program.Title</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <input type="number" name="priority" value="1" min="1" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-success w-100">Добавить</button>
                    </div>
                </form>
            }
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Документы</span>
        @if (canEdit)
        {
            <a asp-action="UploadDocument" asp-route-applicantUserId="@Model.ApplicantUserId" class="btn btn-sm btn-success">
                Добавить документ
            </a>
        }
    </div>
    <div class="card-body">
        @if (!Model.Documents.Any())
        {
            <p class="mb-0">Документы отсутствуют.</p>
        }
        else
        {
            <div class="row">
                @foreach (var doc in Model.Documents)
                {
                    <div class="col-md-6 mb-3">
                        <div class="border rounded p-3 h-100">
                            <p><strong>Тип:</strong> @doc.Type</p>
                            <p><strong>Файл:</strong> @doc.File.FileName</p>
                            @if (!string.IsNullOrWhiteSpace(doc.SeriesNumber))
                            {
                                <p><strong>Серия/номер:</strong> @doc.SeriesNumber</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(doc.IssuedBy))
                            {
                                <p><strong>Кем выдан:</strong> @doc.IssuedBy</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(doc.BirthPlace))
                            {
                                <p><strong>Место рождения:</strong> @doc.BirthPlace</p>
                            }
                            @if (doc.IssueDate.HasValue)
                            {
                                <p><strong>Дата выдачи:</strong> @doc.IssueDate.Value.ToLocalTime()</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(doc.EducationDocumentName))
                            {
                                <p><strong>Документ об образовании:</strong> @doc.EducationDocumentName</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(doc.EducationLevel))
                            {
                                <p><strong>Уровень образования:</strong> @doc.EducationLevel</p>
                            }
                            <p><strong>Загружен:</strong> @doc.CreatedAt.ToLocalTime()</p>

                            @if (canEdit)
                            {
                                <div class="mt-3 d-flex gap-2 flex-wrap">
                                    <a asp-action="EditDocument"
                                       asp-route-applicantUserId="@Model.ApplicantUserId"
                                       asp-route-documentId="@doc.Id"
                                       class="btn btn-sm btn-primary">
                                        Редактировать
                                    </a>

                                    <a asp-action="ReplaceDocumentFile"
                                       asp-route-applicantUserId="@Model.ApplicantUserId"
                                       asp-route-documentId="@doc.Id"
                                       class="btn btn-sm btn-warning">
                                        Заменить файл
                                    </a>

                                    <form asp-action="DeleteDocument" method="post" class="d-inline">
                                        <input type="hidden" name="applicantUserId" value="@Model.ApplicantUserId" />
                                        <input type="hidden" name="documentId" value="@doc.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<p>
    <a asp-action="Admissions" class="btn btn-secondary">Назад к списку</a>
</p>
