@{
    ViewData["Title"] = "Главная";
    var isAuthenticated = ViewBag.IsAuthenticated is bool b && b;
    var userEmail = ViewBag.UserEmail as string;
    var userRole = ViewBag.UserRole as string;
}

<h1>Applicant System</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

@if (isAuthenticated)
{
    <div class="alert alert-success">
        Вы авторизованы @(!string.IsNullOrWhiteSpace(userEmail) ? $"как {userEmail}" : "")
        @(!string.IsNullOrWhiteSpace(userRole) ? $" ({userRole})" : "")
    </div>

    <p>Используйте меню сверху для работы с системой.</p>
}
else
{
    <div class="alert alert-warning">
        Вы не авторизованы.
    </div>

    <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Войти</a>
    <a asp-controller="Account" asp-action="Register" class="btn btn-secondary">Зарегистрироваться</a>
}
